{{- /* Search index. Extends PaperMod's: adds the home page and an hours/location entry. */ -}}
{{- $b := site.Params.business -}}
{{- $index := slice -}}
{{- range site.RegularPages -}}
    {{- if and (not .Params.searchHidden) (ne .Layout `archives`) (ne .Layout `search`) }}
    {{- $index = $index | append (dict "title" .Title "content" (printf "%s %s" (.Params.lead | default "") .Plain) "permalink" .Permalink "summary" (.Description | default .Summary)) -}}
    {{- end }}
{{- end -}}
{{- $hours := slice -}}
{{- range $b.hours }}{{ $hours = $hours | append (printf "%s %s" .label .text) }}{{ end -}}
{{- $visit := printf "Opening hours: %s. %s. Address and location: %s, %s, %s %s, %s. Phone %s. Email %s. Directions, map, parking, store, shop. Methods of payment: %s. Frequent buyer program." (delimit $hours ", ") $b.holidayHours $b.street $b.city $b.region $b.postal $b.neighbourhood $b.phone $b.email (delimit $b.payments ", ") -}}
{{- $index = $index | append (dict "title" "Hours & Location" "content" $visit "permalink" (printf "%s#visit" site.Home.Permalink) "summary" $visit) -}}
{{- $index | jsonify -}}
